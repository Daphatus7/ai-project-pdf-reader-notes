---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, listUrl } from '../lib/posts';

const posts = await getPosts('en');
---

<BaseLayout
  title="Blog"
  description="Notes on AI-assisted reading, research workflows, and building Atlas Notebook."
  lang="en"
  altHref={listUrl('zh')}
>
  <h1 class="mb-8 text-3xl font-bold tracking-tight">Blog</h1>
  <div class="space-y-10">
    {posts.map((post) => <PostCard post={post} />)}
    {posts.length === 0 && <p class="text-slate-500">No posts yet — check back soon.</p>}
  </div>
</BaseLayout>
