---
import type { Lang } from '../lib/posts';

interface Props {
  altHref: string;
  targetLang: Lang;
}

const { altHref, targetLang } = Astro.props;
const label = targetLang === 'zh' ? '中' : 'En';
---

<a href={altHref} class="font-medium text-slate-500 hover:text-slate-900" rel="alternate">
  {label}
</a>
