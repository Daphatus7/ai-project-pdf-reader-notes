---
import HeroCard from './HeroCard.astro';
import { formatDate, postLang, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
---

<article class="group">
  <a href={postUrl(post)} class="block space-y-3">
    <div class="overflow-hidden rounded-2xl transition-transform duration-300 group-hover:scale-[1.02]">
      <HeroCard post={post} size="small" />
    </div>
    <div class="space-y-1">
      <time datetime={post.data.pubDate.toISOString()} class="block text-sm text-slate-500">
        {formatDate(post.data.pubDate, lang)}
      </time>
      <h2 class="text-base font-medium text-slate-900 group-hover:text-slate-600">
        {post.data.title}
      </h2>
    </div>
  </a>
</article>
