---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { BASE, type Lang } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 另一语言版本的站内路径（含 /blog 前缀），用于 hreflang 与语言切换 */
  altHref: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  /** narrow = 文章窄栏（max-w-3xl），wide = 列表页全宽（max-w-7xl） */
  width?: 'narrow' | 'wide';
}

const { title, description, lang, altHref, type = 'website', pubDate, updatedDate, width = 'narrow' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang: Lang = lang === 'en' ? 'zh' : 'en';
const rssHref = lang === 'zh' ? `${BASE}/zh/rss.xml` : `${BASE}/rss.xml`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Atlas Notebook Blog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(altHref, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Atlas Notebook Blog" href={rssHref} />
    <meta property="og:site_name" content="Atlas Notebook" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <Navbar lang={lang} altHref={altHref} />
    <main class={`mx-auto px-4 py-10 ${width === 'wide' ? 'max-w-7xl sm:px-6 lg:px-8' : 'max-w-3xl'}`}>
      <slot />
    </main>
    <footer class="border-t border-slate-200">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-8 text-sm text-slate-400 sm:px-6 lg:px-8">
        <span>© {new Date().getFullYear()} Atlas Notebook</span>
        <a href={rssHref} class="hover:text-slate-600">RSS</a>
      </div>
    </footer>
  </body>
</html>
