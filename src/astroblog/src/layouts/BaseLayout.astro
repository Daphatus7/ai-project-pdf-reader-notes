---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import { BASE, listUrl, type Lang } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 另一语言版本的站内路径（含 /blog 前缀），用于 hreflang 与语言切换 */
  altHref: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
}

const { title, description, lang, altHref, type = 'website', pubDate, updatedDate } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang: Lang = lang === 'en' ? 'zh' : 'en';
const rssHref = lang === 'zh' ? `${BASE}/zh/rss.xml` : `${BASE}/rss.xml`;
const ui = {
  en: { backToApp: 'Atlas Notebook', blog: 'Blog', rss: 'RSS' },
  zh: { backToApp: 'Atlas Notebook', blog: '博客', rss: 'RSS' },
}[lang];
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Atlas Notebook Blog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(altHref, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Atlas Notebook Blog" href={rssHref} />
    <meta property="og:site_name" content="Atlas Notebook" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <div class="flex items-center gap-6">
          <a href="/" class="hover:opacity-70">
            <img src={`${BASE}/logo.svg`} alt={ui.backToApp} width="177" height="42" class="h-6 w-auto" />
          </a>
          <a href={listUrl(lang)} class="text-sm font-medium text-slate-500 hover:text-slate-900">
            {ui.blog}
          </a>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <LangSwitch altHref={altHref} targetLang={altLang} />
          <a href={rssHref} class="text-slate-400 hover:text-slate-600">{ui.rss}</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-slate-200">
      <div class="mx-auto max-w-3xl px-4 py-8 text-sm text-slate-400">
        © {new Date().getFullYear()} Atlas Notebook
      </div>
    </footer>
  </body>
</html>
